{
  "item": [
    {
      "id": "f5ba6891-eba4-49bd-93d9-06831ed55815",
      "name": "Port Calls",
      "description": {
        "content": "Arrival and departure events for vessels or ports.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "8da03b51-2c3a-4a4d-907c-03b6b700fb34",
          "name": "Get Port Calls",
          "request": {
            "name": "Get Port Calls",
            "description": {
              "content": "Return arrival and departure events for one or more vessels (by IMO or MMSI) or for a port (by LOCODE).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "portcalls"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "userkey",
                  "value": "<string>",
                  "description": "(Required) Personal API key issued by VesselFinder."
                },
                {
                  "disabled": false,
                  "key": "interval",
                  "value": "<integer>",
                  "description": "(Required) Maximum age of returned events in minutes."
                },
                {
                  "disabled": false,
                  "key": "imo",
                  "value": "<string>",
                  "description": "Comma-separated list of IMO numbers. One of imo, mmsi, or locode is required."
                },
                {
                  "disabled": false,
                  "key": "mmsi",
                  "value": "<string>",
                  "description": "Comma-separated list of MMSI numbers. One of imo, mmsi, or locode is required."
                },
                {
                  "disabled": false,
                  "key": "locode",
                  "value": "<string>",
                  "description": "UN/LOCODE port identifier. Cannot be combined with imo or mmsi."
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "json",
                  "description": "Response format. Defaults to JSON."
                },
                {
                  "disabled": false,
                  "key": "event",
                  "value": "<string>",
                  "description": "Filter to a single event type."
                },
                {
                  "disabled": false,
                  "key": "fromdate",
                  "value": "<dateTime>",
                  "description": "Start of the date window (YYYY-MM-DD HH:MM:SS, UTC)."
                },
                {
                  "disabled": false,
                  "key": "todate",
                  "value": "<dateTime>",
                  "description": "End of the date window (YYYY-MM-DD HH:MM:SS, UTC)."
                },
                {
                  "disabled": false,
                  "key": "extradata",
                  "value": "<string>",
                  "description": "Additional datasets to include. Supported values are `ais` and `voyage`."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Maximum number of events to return."
                },
                {
                  "disabled": false,
                  "key": "last_id",
                  "value": "<integer>",
                  "description": "Return only events with id greater than this value."
                },
                {
                  "disabled": false,
                  "key": "anchorage",
                  "value": "<integer>",
                  "description": "0 to exclude anchorage events, 1 to include, 2 to return anchorage events only."
                },
                {
                  "disabled": false,
                  "key": "imo_only",
                  "value": "<integer>",
                  "description": "Restrict events to vessels carrying an IMO number."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
