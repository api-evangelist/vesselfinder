      "item": [
        {
          "id": "375e2a60-5b25-4590-82a0-4a16c22ef60a",
          "name": "Get Vessels",
          "request": {
            "name": "Get Vessels",
            "description": {
              "content": "Return AIS and optionally Voyage / Master data for one or more vessels identified by IMO or MMSI.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "vessels"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "userkey",
                  "value": "<string>",
                  "description": "(Required) Personal API key issued by VesselFinder."
                },
                {
                  "disabled": false,
                  "key": "imo",
                  "value": "<string>",
                  "description": "Comma-separated list of IMO numbers. Either imo or mmsi is required."
                },
                {
                  "disabled": false,
                  "key": "mmsi",
                  "value": "<string>",
                  "description": "Comma-separated list of MMSI numbers. Either imo or mmsi is required."
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "json",
                  "description": "Response format. Defaults to JSON."
                },
                {
                  "disabled": false,
                  "key": "extradata",
                  "value": "<string>",
                  "description": "Additional datasets to include in the response. Supported values are `voyage` and `master`."
                },
                {
                  "disabled": false,
                  "key": "interval",
                  "value": "<integer>",
                  "description": "Maximum age of returned positions in minutes."
                },
                {
                  "disabled": false,
                  "key": "sat",
                  "value": "0",
                  "description": "Set to 1 to include satellite positions."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
