{
  "opencollection": "1.0.0",
  "info": {
    "name": "VesselFinder AIS Containers Master Data API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "userkey",
      "value": "{{userkey}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Master Data",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Master Data",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.vesselfinder.com/masterdata",
            "params": [
              {
                "name": "userkey",
                "value": "",
                "type": "query",
                "description": "Personal API key issued by VesselFinder."
              },
              {
                "name": "imo",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of IMO numbers."
              },
              {
                "name": "format",
                "value": "",
                "type": "query",
                "description": "Response format. Defaults to JSON."
              }
            ]
          },
          "docs": "Return static vessel particulars (Master dataset) by IMO."
        }
      ]
    }
  ],
  "bundled": true
}