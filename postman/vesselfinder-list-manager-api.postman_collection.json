            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/listmanager?userkey=<string>",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "listmanager"
              ],
              "query": [
                {
                  "description": "(Required) Personal API key issued by VesselFinder.",
                  "key": "userkey",
                  "value": "<string>"
                }
              ]
            },
            "description": "Return the current list of vessels (IMO and MMSI) backing the VesselsList method."
