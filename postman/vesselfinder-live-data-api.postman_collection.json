            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/livedata?userkey=<string>&format=json&interval=<integer>",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "livedata"
              ],
              "query": [
                {
                  "description": "(Required) Personal API key issued by VesselFinder.",
